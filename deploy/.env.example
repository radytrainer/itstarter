# Production settings for the server. Copy to deploy/.env ON THE SERVER and fill in every value.
# Never commit deploy/.env. Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Keep copies of the passwords (especially BACKUP_PASSPHRASE) in a password manager.

# ---------- Site ----------
DOMAIN=itstarter.store
# Let's Encrypt sends certificate expiry warnings here.
LETSENCRYPT_EMAIL=
# 1 = use Let's Encrypt's test servers first (certificate not trusted by browsers; no rate limits).
LETSENCRYPT_STAGING=0
TLS_MODE=letsencrypt
TZ=Asia/Phnom_Penh

# ---------- Version (set by scripts/deploy.sh) ----------
# Images built by GitHub Actions: ghcr.io/<github-owner>/<repository> in lower case.
IMAGE_PREFIX=ghcr.io/your-github-name/itstarter
APP_VERSION=

# ---------- Secrets (16+ random characters each; letters and digits only) ----------
POSTGRES_DB=itstarter
POSTGRES_USER=itstarter
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# The first admin account (12+ characters). Change it after the first login.
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
# open = students can create their own account on the site; closed = only staff create accounts.
SELF_REGISTRATION=open

# ---------- Backups ----------
# Encrypts every backup. WITHOUT IT NO BACKUP CAN BE RESTORED: store it outside the server too.
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/itstarter
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=60
# OVH Object Storage (Public Cloud → Object Storage → S3 user). Region e.g. sgp (Singapore).
S3_BUCKET=
S3_ENDPOINT=https://s3.sgp.io.cloud.ovh.net
S3_REGION=sgp
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Alerts (Telegram) ----------
# Create a bot with @BotFather; get the chat id from https://api.telegram.org/bot<token>/getUpdates
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

LOG_LEVEL=info
