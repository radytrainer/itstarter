# Production site for ${DOMAIN} (HTTPS). Filled in by the nginx image at start-up from
# deploy/.env: DOMAIN, PUBLIC_PORT_SUFFIX (empty in production) and HSTS_MAX_AGE.

# Containers get a new internal address when they are recreated (every deploy). Ask Docker's DNS
# again every 10 s instead of keeping the address from start-up (which would give 502 errors).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream itstarter_web {
    zone itstarter_web 64k;
    server web:3000 resolve;
    keepalive 16;
}

upstream itstarter_api {
    zone itstarter_api 64k;
    server api:4000 resolve;
    keepalive 16;
}

# Coarse per-IP limit in front of the API; the API applies finer limits (e.g. login) itself.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;

# ---------- Port 80: certificate checks, health, and a redirect to HTTPS ----------
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # Let's Encrypt proves we own the domain by fetching a file from here.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # Container health check (from inside the container only).
    location = /healthz {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://itstarter_web;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        return 301 https://${DOMAIN}${PUBLIC_PORT_SUFFIX}$request_uri;
    }
}

# ---------- Shared TLS settings (Mozilla "intermediate": TLS 1.2 and 1.3) ----------
ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# ---------- www.${DOMAIN} → ${DOMAIN} ----------
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    server_tokens off;
    return 301 https://${DOMAIN}${PUBLIC_PORT_SUFFIX}$request_uri;
}

# ---------- The app ----------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    server_tokens off;
    client_max_body_size 2m;

    # Browsers must use HTTPS for this site from now on (1 year in production).
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/gzip.conf;

    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://itstarter_api;
        include /etc/nginx/snippets/proxy.conf;
        # API unreachable (e.g. restarting during a deploy): answer in the API's JSON format.
        error_page 502 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
        return 503 '{"success":false,"error":{"code":"SERVICE_UNAVAILABLE","message":"The service is restarting. Please try again in a moment."}}';
    }

    # Static build files never change (their names contain a hash): cache them for a year.
    location /_next/static/ {
        proxy_pass http://itstarter_web;
        include /etc/nginx/snippets/proxy.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        proxy_pass http://itstarter_web;
        include /etc/nginx/snippets/proxy.conf;
    }
}
