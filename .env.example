# Copy to .env and adjust. Never commit .env.
# These values are for YOUR COMPUTER ONLY. They are public (this file is in Git): on a real server
# the API and the seed refuse them (see docs/SECURITY.md → "Production safety checks").
#   cp .env.example .env

# ---------- PostgreSQL (used by Docker Compose) ----------
POSTGRES_DB=itstarter
POSTGRES_USER=itstarter
# Local only. Use a long random value in production (letters/digits avoid URL-encoding issues).
POSTGRES_PASSWORD=itstarter_local_dev_only

# ---------- Host ports (change if something else already uses them) ----------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
NGINX_HOST_PORT=8088

# ---------- API, when run on your machine with `npm run dev` ----------
# Inside Docker, Compose builds these from the values above.
DATABASE_URL=postgres://itstarter:itstarter_local_dev_only@localhost:5433/itstarter
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Public origin of the web app; the only origin allowed by CORS.
APP_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- Seed accounts (npm run db:seed / npm run docker:seed) ----------
# Production requires these (12+ characters) and creates only the admin unless SEED_DEMO_USERS=true.
# Keep the quotes: '#' would otherwise start a comment.
SEED_ADMIN_PASSWORD='Admin#2028dev'
SEED_DEMO_USERS=true
SEED_TEACHER_PASSWORD='Teacher#2028dev'
SEED_STUDENT_PASSWORD='Student#2028dev'

# ---------- Web (Next.js server → API) ----------
# The web app falls back to http://localhost:4000 when this is unset.
API_INTERNAL_URL=http://localhost:4000
