{
  "name": "it-starter-2028",
  "version": "0.1.0",
  "private": true,
  "description": "IT Starter 2028 \u2014 a friendly, mobile-first IT learning platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @itstarter/api",
    "dev:web": "npm run dev -w @itstarter/web",
    "build": "npm run build -w @itstarter/api && npm run build -w @itstarter/web",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:deps": "docker compose up -d postgres redis",
    "docker:logs": "docker compose logs -f --tail=100",
    "db:migrate": "npm run db:migrate -w @itstarter/api",
    "db:seed": "npm run db:seed -w @itstarter/api",
    "db:generate": "npm run db:generate -w @itstarter/api",
    "docker:migrate": "docker compose run --rm tools node apps/api/dist/migrate.js",
    "docker:seed": "docker compose run --rm tools node apps/api/dist/seed.js",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:reset": "node e2e/reset-test-students.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
